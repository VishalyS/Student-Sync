# Target API base URL for custom decoupled deployments (e.g. https://api.studentsync.psgtech.ac.in).
# Leave empty for standard single-domain deployments or reverse proxies (Nginx / Caddy / Vercel rewrites)
# where requests to /api are proxied to the Flask backend on the same origin.
VITE_API_BASE_URL=
