# ==============================================================================
# Student Sync - Environment Configuration Template
# All production secrets MUST be supplied securely via cloud secret managers.
# ==============================================================================

# Database
MONGO_URI=
DB_NAME=ecampus
USERS_COLLECTION=new_users

# Core Security & Authentication
SECRET_KEY=
FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# CORS Production Allowed Origins (comma-separated, no wildcards in production)
CORS_ORIGINS=https://studentsync.psgtech.ac.in

# Outbound Email & Alerting (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Hostel Subsystem Configuration
HOSTEL_BASE_URL=https://edviewx.psgtech.ac.in/Hostel
HOSTEL_USERNAME=
HOSTEL_PASSWORD=
HOSTEL_SUBSYSTEM_PATH=
MONGODB_HOSTEL_COLLECTION=hostel_students
