# ==============================================================================
# Student Sync — Production Environment Configuration Template
# All production secrets MUST be supplied securely via cloud secret managers or server env.
# Never commit real credentials, passwords, or encryption keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecampus?retryWrites=true&w=majority
DB_NAME=ecampus
USERS_COLLECTION=new_users

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Credentials Protection (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Master authenticated symmetric encryption key for portal passwords at rest (Fernet AES-128-CBC + HMAC-SHA256).
# Generate securely via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STUDENT_SYNC_ENCRYPTION_KEY=

# Application secret key for signing student Bearer HMAC-SHA256 tokens.
# Generate securely via:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Environment mode (must be 'production' for live deployments)
FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Origins (Strict URL list, comma-separated, no wildcards)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://studentsync.psgtech.ac.in,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Outbound Email & Alerting (Google Workspace / Gmail SMTP)
# ------------------------------------------------------------------------------
# Requires a 16-character Google App Password (spaces stripped automatically)
# Generate via: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studentsync12@gmail.com
SMTP_PASSWORD=
ADMIN_EMAIL=studentsync12@gmail.com

# ------------------------------------------------------------------------------
# 5. Frontend & Domain URLs
# ------------------------------------------------------------------------------
FRONTEND_URL=https://studentsync.psgtech.ac.in
# Optional: Set VITE_API_BASE_URL if the frontend is hosted separately from the Flask API (e.g. Vercel -> Render)
# Leave empty if serving through a single reverse proxy or relative /api routing.
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 6. Standalone Hostel Subsystem Integration
# ------------------------------------------------------------------------------
HOSTEL_BASE_URL=https://edviewx.psgtech.ac.in/Hostel
HOSTEL_USERNAME=
HOSTEL_PASSWORD=
HOSTEL_SUBSYSTEM_PATH=
MONGODB_HOSTEL_COLLECTION=hostel_students
